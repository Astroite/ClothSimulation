#include "tinyhood_mlp.hlsli"

// `predictor` selects where the step displacement comes from: 0 is the decoder, non-zero is
// `gravityDisplacement` with the network skipped entirely. That second path is comparison branch B
// of tools/gate_g0.py -- "XPBD only" means no network at all rather than a zeroed network output,
// because the decoder's output mean is a dataset artifact and predicting it would leave branch B
// with no downward force. The CPU passes dt^2 * g, and zero on the settle step (gate_g0.py's
// BallisticGravity does the same: at dt = 1/3 a full gravity step is 1.09 m, a hundred times the
// garment's per-step motion, and no number of sweeps recovers from it).
//
// gate_g0.py normalises dt^2 * g and lets integrate denormalise it again, which is an artifact of
// reusing the predictor interface; taking the displacement directly is the same quantity minus one
// float32 round trip (about 1e-7 m, four orders below the established cross-process noise -- see
// results/GATE_G0_RESULTS.md section 8).
//
// `guideMode` is the soft-guide switch. See hood_integrate.comp for the full reasoning; the two
// shaders differ only in latent width and have to stay behaviourally identical, because the shipping
// student runs through this one.
struct Params {
    uint clothCount, firstStep, collisionProjection, decoderMlp;
    uint predictor, guideMode, pad1, pad2;
    float4 gravityDisplacement;
    // `substepScale` is 1 / substeps and `substepGravity` is h^2 g with h = dt / substeps. Together
    // they turn this pass into the *first* substep's prediction; hood_substep.comp produces the rest.
    // At one substep the scale is 1 and the gravity is zero, and the arithmetic below is written so
    // that case is bit-identical to the pre-substep shader.
    float guideTrustRatio, substepScale, pad4, pad5;
    float4 substepGravity;
};
cbuffer ubo : register(b13) { Params params; };
[[vk::binding(0)]] StructuredBuffer<float> weights;
[[vk::binding(1)]] StructuredBuffer<uint4> mlpTable;
[[vk::binding(2)]] StructuredBuffer<float> normalizers;
[[vk::binding(3)]] StructuredBuffer<float> nodeLatent;
[[vk::binding(4)]] RWStructuredBuffer<float4> clothPosition;
[[vk::binding(5)]] RWStructuredBuffer<float4> clothPrevious;
[[vk::binding(6)]] StructuredBuffer<float4> effectivePosition;
[[vk::binding(7)]] StructuredBuffer<float4> pinTarget;
[[vk::binding(8)]] StructuredBuffer<uint> pinMask;
[[vk::binding(9)]] RWStructuredBuffer<float4> accelerationOut;
[[vk::binding(10)]] StructuredBuffer<uint> worldObstacle;
[[vk::binding(11)]] StructuredBuffer<float4> proxyTarget;
[[vk::binding(12)]] StructuredBuffer<float4> proxyNormal;
// 13 is the uniform buffer above.
[[vk::binding(14)]] RWStructuredBuffer<float4> guideTarget;
[[vk::binding(15)]] RWStructuredBuffer<float> guideConfidence;
[[vk::binding(16)]] StructuredBuffer<float> xpbdMinEdge;
// The frame's endpoints, for hood_substep.comp to interpolate the guide between. Written every step so
// neither can be stale, and unused when substeps == 1.
[[vk::binding(17)]] RWStructuredBuffer<float4> frameEntry;
[[vk::binding(18)]] RWStructuredBuffer<float4> guidePrediction;

[numthreads(HOOD_TINY_LATENT, 1, 1)]
void main(uint3 groupId : SV_GroupID, uint lane : SV_GroupIndex)
{
    const uint vertex = groupId.x;
    if (vertex >= params.clothCount) return;
    // `predictor` is uniform across the dispatch, so every lane of the group takes the same side of
    // this branch and the barriers inside it stay group-synchronous.
    if (params.predictor == 0) {
        const MlpDesc mlp = loadMlp(mlpTable, params.decoderMlp);
        tinyScratchA[lane] = nodeLatent[vertex * TINY_LATENT + lane];
        GroupMemoryBarrierWithGroupSync();
        tinyScratchB[lane] = max(tinyHiddenLinear(weights, mlp.w0, mlp.b0, lane, TINY_LATENT, TINY_LATENT, true), 0.0);
        GroupMemoryBarrierWithGroupSync();
        tinyScratchA[lane] = max(tinyHiddenLinear(weights, mlp.w1, mlp.b1, lane, TINY_LATENT, TINY_LATENT, false), 0.0);
        GroupMemoryBarrierWithGroupSync();
        if (lane < 3)
            tinyScratchB[lane] = tinyHiddenLinear(weights, mlp.w2, mlp.b2, lane, TINY_LATENT, 3, true) * normalizers[73 + lane] + normalizers[70 + lane];
        GroupMemoryBarrierWithGroupSync();
    }
    if (lane == 0) {
        const float3 acceleration = params.predictor != 0 ? params.gravityDisplacement.xyz
            : float3(tinyScratchB[0], tinyScratchB[1], tinyScratchB[2]);
        const float3 effective = effectivePosition[vertex].xyz;
        const float3 oldPosition = clothPosition[vertex].xyz;
        const float3 oldPrevious = clothPrevious[vertex].xyz;
        const float3 velocity = effective - (pinMask[vertex] != 0 ? oldPosition : oldPrevious);
        float3 predicted = effective + (velocity + acceleration);
        const uint obstacle = worldObstacle[vertex];
        if (params.collisionProjection != 0 && pinMask[vertex] == 0 && obstacle != 0xffffffffu) {
            const float3 normal = normalize(proxyNormal[obstacle].xyz);
            const float signedDistance = dot(predicted - proxyTarget[obstacle].xyz, normal);
            if (signedDistance < 0.0) predicted -= signedDistance * normal;
        }
        if (pinMask[vertex] != 0) predicted = pinTarget[vertex].xyz;

        // Soft-guided mode: hand the prediction to hood_xpbd.comp as a compliant target and start the
        // solve from the inertial prediction instead, so the constraints keep the final say. Written
        // unconditionally so the guide buffer can never be stale; confidence defaults to 1.
        //
        // This is the FIRST substep's instalment. `substepScale` is 1 / substeps, which is also substep
        // 0's fraction; the guide has to arrive in equal parts or splitting the sweep achieves nothing.
        // The endpoint guard is there because `lerp(a, b, 1)` is not bit-identical to `b`, and the
        // one-substep path has to stay exactly what every existing golden recorded.
        guideTarget[vertex] = float4(params.substepScale >= 1.0 ? predicted
            : lerp(effective, predicted, params.substepScale), 1.0);
        float confidence = 1.0;
        if (params.guideTrustRatio > 0.0) {
            // `acceleration` *is* the prediction minus the inertial prediction, so the trust region
            // needs no extra state. Per-vertex radius, because a global one lets the single shortest
            // edge in the mesh dictate the clamp everywhere.
            const float allowed = max(params.guideTrustRatio * xpbdMinEdge[vertex], 1.0e-12);
            confidence = clamp(2.0 - length(acceleration) / allowed, 0.0, 1.0);
        }
        guideConfidence[vertex] = confidence;
        frameEntry[vertex] = float4(effective, 1.0);
        guidePrediction[vertex] = float4(predicted, 1.0);

        if (params.guideMode != 0 && pinMask[vertex] == 0) {
            // Start the solve at physics instead of at the prediction. `substepScale == 1` keeps the
            // expression `effective + velocity` exactly; a smaller scale is the first of `substeps`
            // Verlet steps, so the frame-length velocity has to be divided down or the substep would
            // predict a whole frame of motion in a fraction of the time -- N times the real velocity,
            // every substep, which diverges rather than merely drifting.
            predicted = params.substepScale == 1.0
                ? effective + velocity
                : effective + velocity * params.substepScale + params.substepGravity.xyz;
        }

        clothPrevious[vertex] = float4(params.firstStep != 0 ? predicted : effective, 1.0);
        clothPosition[vertex] = float4(predicted, 1.0);
        accelerationOut[vertex] = float4(acceleration, 0.0);
    }
}
