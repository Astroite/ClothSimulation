#include "tinyhood_mlp.hlsli"

struct Push { uint block, kind, count, clothCount; };
[[vk::push_constant]] Push push;
[[vk::binding(0)]] StructuredBuffer<float> weights;
[[vk::binding(1)]] StructuredBuffer<uint4> mlpTable;
[[vk::binding(2)]] StructuredBuffer<float> nodeLatent;
[[vk::binding(3)]] StructuredBuffer<float> meshIn;
[[vk::binding(4)]] StructuredBuffer<float> worldDirectIn;
[[vk::binding(5)]] StructuredBuffer<float> worldInverseIn;
[[vk::binding(6)]] RWStructuredBuffer<float> meshOut;
[[vk::binding(7)]] RWStructuredBuffer<float> worldDirectOut;
[[vk::binding(8)]] RWStructuredBuffer<float> worldInverseOut;
[[vk::binding(9)]] StructuredBuffer<uint> meshSenders;
[[vk::binding(10)]] StructuredBuffer<uint> meshReceivers;
[[vk::binding(11)]] StructuredBuffer<uint> worldObstacle;

float edgeValue(uint element, uint index)
{
    if (push.kind == 0) {
        if (index < TINY_LATENT) return nodeLatent[meshReceivers[element] * TINY_LATENT + index];
        if (index < TINY_LATENT * 2) return nodeLatent[meshSenders[element] * TINY_LATENT + index - TINY_LATENT];
        return meshIn[element * TINY_LATENT + index - TINY_LATENT * 2];
    }
    const uint cloth = element;
    const uint obstacleNode = push.clothCount + worldObstacle[cloth];
    if (push.kind == 1) {
        if (index < TINY_LATENT) return nodeLatent[obstacleNode * TINY_LATENT + index];
        if (index < TINY_LATENT * 2) return nodeLatent[cloth * TINY_LATENT + index - TINY_LATENT];
        return worldDirectIn[cloth * TINY_LATENT + index - TINY_LATENT * 2];
    }
    if (index < TINY_LATENT) return nodeLatent[cloth * TINY_LATENT + index];
    if (index < TINY_LATENT * 2) return nodeLatent[obstacleNode * TINY_LATENT + index - TINY_LATENT];
    return worldInverseIn[cloth * TINY_LATENT + index - TINY_LATENT * 2];
}
float oldEdge(uint element, uint lane)
{
    return push.kind == 0 ? meshIn[element * TINY_LATENT + lane]
        : (push.kind == 1 ? worldDirectIn[element * TINY_LATENT + lane] : worldInverseIn[element * TINY_LATENT + lane]);
}
void writeEdge(uint element, uint lane, float value)
{
    if (push.kind == 0) meshOut[element * TINY_LATENT + lane] = value;
    else if (push.kind == 1) worldDirectOut[element * TINY_LATENT + lane] = value;
    else worldInverseOut[element * TINY_LATENT + lane] = value;
}
[numthreads(TINY_LATENT, 1, 1)]
void main(uint3 groupId : SV_GroupID, uint lane : SV_GroupIndex)
{
    const uint element = groupId.x;
    if (element >= push.count || (push.kind != 0 && worldObstacle[element] == 0xffffffffu)) return;
    const MlpDesc mlp = loadMlp(mlpTable, 3 + push.block * 3 + (push.kind == 0 ? 0 : 1));
    float value = weights[mlp.b0 + lane];
    [loop] for (uint input = 0; input < TINY_LATENT * 3; ++input)
        value += weights[mlp.w0 + lane * (TINY_LATENT * 3) + input] * edgeValue(element, input);
    tinyScratchA[lane] = max(value, 0.0);
    GroupMemoryBarrierWithGroupSync();
    tinyScratchB[lane] = max(tinyHiddenLinear(weights, mlp.w1, mlp.b1, lane, TINY_LATENT, true), 0.0);
    GroupMemoryBarrierWithGroupSync();
    tinyScratchA[lane] = tinyHiddenLinear(weights, mlp.w2, mlp.b2, lane, TINY_LATENT, false);
    tinyLayerNorm(lane, TINY_LATENT);
    const float update = (tinyScratchA[lane] - tinyMean) * tinyInvStd * weights[mlp.lnWeight + lane] + weights[mlp.lnBias + lane];
    writeEdge(element, lane, oldEdge(element, lane) + update);
}
