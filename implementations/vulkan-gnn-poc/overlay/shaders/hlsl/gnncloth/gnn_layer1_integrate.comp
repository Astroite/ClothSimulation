// Shader-friendly fixed-topology GNN, layer 1 plus stable integration/constraints.

struct Particle {
    float4 pos;
    float4 vel;
    float4 uv;
    float4 normal;
    float4 rest;
};

struct UBO {
    float deltaT;
    float particleMass;
    float springStiffness;
    float damping;
    float restDistH;
    float restDistV;
    float restDistD;
    float sphereRadius;
    float4 spherePos;
    float4 gravity;
    int2 particleCount;
    uint vertexCount;
    uint edgeCount;
    float maxSpeed;
    float maxAcceleration;
    float stretchComplianceMicro;
    float bendComplianceMicro;
    float xpbdVelocityDamping;
    float3 sphereVelocity;
};

[[vk::binding(0)]] StructuredBuffer<Particle> particleIn;
[[vk::binding(1)]] RWStructuredBuffer<Particle> particleOut;
cbuffer ubo : register(b2) { UBO params; };
[[vk::binding(3)]] StructuredBuffer<uint> vertexOffsets;
[[vk::binding(4)]] StructuredBuffer<uint> neighborIndices;
[[vk::binding(5)]] StructuredBuffer<float> weights;
[[vk::binding(6)]] RWStructuredBuffer<float4> hiddenState;
[[vk::binding(7)]] RWStructuredBuffer<float4> accelerationOut;

static const uint HIDDEN_DIM = 16;
static const uint OUTPUT_DIM = 3;
static const uint OUTPUT_SCALE_OFFSET = 10;
static const uint SELF1_OFFSET = 349;
static const uint NEIGHBOR1_OFFSET = 397;
static const uint BIAS1_OFFSET = 445;

groupshared float neighborHidden[HIDDEN_DIM];
groupshared float predictedAcceleration[OUTPUT_DIM];

float hiddenValue(uint vertex, uint channel)
{
    return hiddenState[vertex * 4 + channel / 4][channel % 4];
}

float3 clampMagnitude(float3 value, float maximum)
{
    const float magnitude = length(value);
    return (magnitude > maximum && magnitude > 0.0) ? value * (maximum / magnitude) : value;
}

[numthreads(32, 1, 1)]
void main(uint3 groupID : SV_GroupID, uint lane : SV_GroupIndex)
{
    const uint vertex = groupID.x;
    if (vertex >= params.vertexCount) return;

    if (lane < HIDDEN_DIM) {
        const uint begin = vertexOffsets[vertex];
        const uint end = vertexOffsets[vertex + 1];
        float sum = 0.0;
        for (uint edge = begin; edge < end; ++edge) {
            sum += hiddenValue(neighborIndices[edge], lane);
        }
        neighborHidden[lane] = sum / max(float(end - begin), 1.0);
    }
    GroupMemoryBarrierWithGroupSync();

    if (lane < OUTPUT_DIM) {
        float value = weights[BIAS1_OFFSET + lane];
        [unroll]
        for (uint channel = 0; channel < HIDDEN_DIM; ++channel) {
            const uint matrixIndex = lane * HIDDEN_DIM + channel;
            value += hiddenValue(vertex, channel) * weights[SELF1_OFFSET + matrixIndex];
            value += neighborHidden[channel] * weights[NEIGHBOR1_OFFSET + matrixIndex];
        }
        predictedAcceleration[lane] = value * weights[OUTPUT_SCALE_OFFSET + lane];
    }
    GroupMemoryBarrierWithGroupSync();

    if (lane == 0) {
        Particle next = particleIn[vertex];
        const bool pinnedInputDrift = next.rest.w > 0.5 && any(abs(next.pos.xyz - next.rest.xyz) > 1.0e-6);
        const float3 previousPosition = next.pos.xyz;
        next.normal = float4(previousPosition, 1.0);
        float3 acceleration = float3(
            predictedAcceleration[0],
            predictedAcceleration[1],
            predictedAcceleration[2]);
        bool accelerationClamped = false;
        bool speedClamped = false;
        if (next.rest.w > 0.5) {
            acceleration = 0.0;
            next.pos = float4(next.rest.xyz, 1.0);
            next.vel = 0.0;
            next.normal = float4(next.rest.xyz, 1.0);
        } else {
            accelerationClamped = length(acceleration) > params.maxAcceleration;
            acceleration = clampMagnitude(acceleration, params.maxAcceleration);
            const float3 predictedVelocity = next.vel.xyz + acceleration * params.deltaT;
            speedClamped = length(predictedVelocity) > params.maxSpeed;
            float3 velocity = clampMagnitude(predictedVelocity, params.maxSpeed);
            float3 position = next.pos.xyz + velocity * params.deltaT;
            next.pos = float4(position, 1.0);
            next.vel = float4(velocity, 0.0);
        }
        const bool finiteState = all(isfinite(next.pos)) && all(isfinite(next.vel)) && all(isfinite(next.normal)) && all(isfinite(acceleration));
        // w carries a status bitfield rather than a plain health flag:
        //   1 = non-finite state or pinned drift (hard failure)
        //   2 = acceleration clamp engaged
        //   4 = speed clamp engaged
        // Bits 2 and 4 are telemetry. The clamps are the only thing keeping the
        // network stable outside its training distribution, so without this a
        // saturating clamp is indistinguishable from a network behaving well.
        const float status = ((finiteState && !pinnedInputDrift) ? 0.0 : 1.0)
            + (accelerationClamped ? 2.0 : 0.0)
            + (speedClamped ? 4.0 : 0.0);
        accelerationOut[vertex] = float4(acceleration, status);
        particleOut[vertex] = next;
    }
}
