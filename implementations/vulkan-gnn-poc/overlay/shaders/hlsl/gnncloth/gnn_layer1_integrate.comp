// Shader-friendly fixed-topology GNN, layer 1 plus stable integration/constraints.

#include "common.hlsli"


// Ablation: where the acceleration comes from. The network is trained to imitate
// the analytic target recorded in model.json, so running that formula directly
// isolates the network's own error, and the gravity-only baseline isolates what
// the neighbour coupling contributes. Plain zero also removes gravity, so it
// only bounds how much any acceleration at all matters.
static const uint ABLATE_GNN = 0;
static const uint ABLATE_ANALYTIC = 1;
static const uint ABLATE_ZERO = 2;
static const uint ABLATE_GRAVITY = 3;
// Must match oracle_acceleration() in model/vgnn.py.
static const float ANALYTIC_STIFFNESS = 18.0;
static const float ANALYTIC_DAMPING = 0.9;

struct PushConstants {
    uint ablationMode;
    uint unused;
};
[[vk::push_constant]] PushConstants pushConstants;

groupshared float neighborHidden[VGNN_HIDDEN_DIM];
groupshared float predictedAcceleration[VGNN_OUTPUT_DIM];

float hiddenValue(uint vertex, uint channel)
{
    return hiddenState[vertex * 4 + channel / 4][channel % 4];
}

[numthreads(32, 1, 1)]
void main(uint3 groupID : SV_GroupID, uint lane : SV_GroupIndex)
{
    const uint vertex = groupID.x;
    if (vertex >= params.vertexCount) return;

    // pushConstants.ablationMode is uniform across the group, so every barrier
    // below is still reached by all lanes.
    if (pushConstants.ablationMode == ABLATE_GNN) {
        if (lane < VGNN_HIDDEN_DIM) {
            const uint begin = vertexOffsets[vertex];
            const uint end = vertexOffsets[vertex + 1];
            float sum = 0.0;
            for (uint edge = begin; edge < end; ++edge) {
                sum += hiddenValue(neighborIndices[edge], lane);
            }
            neighborHidden[lane] = sum / max(float(end - begin), 1.0);
        }
        GroupMemoryBarrierWithGroupSync();

        if (lane < VGNN_OUTPUT_DIM) {
            float value = weights[VGNN_BIAS1_OFFSET + lane];
            [unroll]
            for (uint channel = 0; channel < VGNN_HIDDEN_DIM; ++channel) {
                const uint matrixIndex = lane * VGNN_HIDDEN_DIM + channel;
                value += hiddenValue(vertex, channel) * weights[VGNN_SELF1_OFFSET + matrixIndex];
                value += neighborHidden[channel] * weights[VGNN_NEIGHBOR1_OFFSET + matrixIndex];
            }
            predictedAcceleration[lane] = value * weights[VGNN_OUTPUT_SCALE_OFFSET + lane];
        }
    } else if (pushConstants.ablationMode == ABLATE_ANALYTIC) {
        // The training target evaluated directly: no layer 0, no weights.
        if (lane < VGNN_OUTPUT_DIM) {
            const uint begin = vertexOffsets[vertex];
            const uint end = vertexOffsets[vertex + 1];
            float sum = 0.0;
            for (uint edge = begin; edge < end; ++edge) {
                const uint neighbor = neighborIndices[edge];
                sum += particleIn[neighbor].pos[lane] - particleIn[neighbor].rest[lane];
            }
            const float neighborMean = sum / max(float(end - begin), 1.0);
            const Particle self = particleIn[vertex];
            const float selfDisplacement = self.pos[lane] - self.rest[lane];
            predictedAcceleration[lane] = ANALYTIC_STIFFNESS * (neighborMean - selfDisplacement)
                - ANALYTIC_DAMPING * self.vel[lane] + params.gravity[lane];
        }
    } else if (pushConstants.ablationMode == ABLATE_GRAVITY) {
        // The analytic target with the neighbour coupling removed, so the
        // difference against it is what the graph structure contributes.
        if (lane < VGNN_OUTPUT_DIM) {
            const Particle self = particleIn[vertex];
            predictedAcceleration[lane] = -ANALYTIC_DAMPING * self.vel[lane] + params.gravity[lane];
        }
    } else {
        if (lane < VGNN_OUTPUT_DIM) predictedAcceleration[lane] = 0.0;
    }
    GroupMemoryBarrierWithGroupSync();

    if (lane == 0) {
        Particle next = particleIn[vertex];
        const bool pinnedInputDrift = next.rest.w > 0.5 && any(abs(next.pos.xyz - next.rest.xyz) > 1.0e-6);
        const float3 previousPosition = next.pos.xyz;
        next.previousPosition = float4(previousPosition, 1.0);
        float3 acceleration = float3(
            predictedAcceleration[0],
            predictedAcceleration[1],
            predictedAcceleration[2]);
        bool accelerationClamped = false;
        bool speedClamped = false;
        if (next.rest.w > 0.5) {
            acceleration = 0.0;
            next.pos = float4(next.rest.xyz, 1.0);
            next.vel = 0.0;
            next.previousPosition = float4(next.rest.xyz, 1.0);
        } else {
            accelerationClamped = length(acceleration) > params.maxAcceleration;
            acceleration = clampMagnitude(acceleration, params.maxAcceleration);
            const float3 predictedVelocity = next.vel.xyz + acceleration * params.deltaT;
            speedClamped = length(predictedVelocity) > params.maxSpeed;
            float3 velocity = clampMagnitude(predictedVelocity, params.maxSpeed);
            float3 position = next.pos.xyz + velocity * params.deltaT;
            next.pos = float4(position, 1.0);
            next.vel = float4(velocity, 0.0);
        }
        const bool finiteState = all(isfinite(next.pos)) && all(isfinite(next.vel)) && all(isfinite(next.previousPosition)) && all(isfinite(acceleration));
        // w carries a status bitfield rather than a plain health flag:
        //   1 = non-finite state or pinned drift (hard failure)
        //   2 = acceleration clamp engaged
        //   4 = speed clamp engaged
        // Bits 2 and 4 are telemetry. The clamps are the only thing keeping the
        // network stable outside its training distribution, so without this a
        // saturating clamp is indistinguishable from a network behaving well.
        const float status = ((finiteState && !pinnedInputDrift) ? 0.0 : 1.0)
            + (accelerationClamped ? 2.0 : 0.0)
            + (speedClamped ? 4.0 : 0.0);
        accelerationOut[vertex] = float4(acceleration, status);
        particleOut[vertex] = next;
    }
}
