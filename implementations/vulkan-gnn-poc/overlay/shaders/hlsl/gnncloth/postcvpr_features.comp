struct Params {
    uint clothCount, proxyCount, triangleCount, meshEdgeCount;
    uint coarse0Count, coarse1Count, embeddingOffset, levelEmbeddingOffset;
    float timestep, collisionRadius, material0, material1;
    float material2, pad0, pad1, pad2;
};
cbuffer ubo : register(b28) { Params params; };

[[vk::binding(0)]] StructuredBuffer<float4> clothPosition;
[[vk::binding(1)]] StructuredBuffer<float4> clothPrevious;
[[vk::binding(2)]] StructuredBuffer<float4> pinTarget;
[[vk::binding(3)]] StructuredBuffer<uint> pinMask;
[[vk::binding(4)]] StructuredBuffer<uint> clothTriangles;
[[vk::binding(5)]] StructuredBuffer<uint> meshSenders;
[[vk::binding(6)]] StructuredBuffer<uint> meshReceivers;
[[vk::binding(7)]] StructuredBuffer<float4> clothRestPosition;
[[vk::binding(8)]] StructuredBuffer<float> clothMass;
[[vk::binding(9)]] StructuredBuffer<float4> proxyPosition;
[[vk::binding(10)]] StructuredBuffer<float4> proxyTarget;
[[vk::binding(11)]] StructuredBuffer<float4> proxyNormal;
[[vk::binding(12)]] RWStructuredBuffer<uint> worldObstacle;
[[vk::binding(13)]] RWStructuredBuffer<float> nodeFeatures;
[[vk::binding(14)]] RWStructuredBuffer<float> meshFeatures;
[[vk::binding(15)]] RWStructuredBuffer<float> worldDirectFeatures;
[[vk::binding(16)]] RWStructuredBuffer<float> worldInverseFeatures;
[[vk::binding(17)]] StructuredBuffer<float> weights;
[[vk::binding(18)]] StructuredBuffer<float> normalizers;
[[vk::binding(19)]] RWStructuredBuffer<float4> effectivePosition;
[[vk::binding(20)]] RWStructuredBuffer<uint> activeProxy;
[[vk::binding(21)]] StructuredBuffer<uint> vertexLevel;
[[vk::binding(22)]] StructuredBuffer<uint> coarse0Senders;
[[vk::binding(23)]] StructuredBuffer<uint> coarse0Receivers;
[[vk::binding(24)]] StructuredBuffer<uint> coarse1Senders;
[[vk::binding(25)]] StructuredBuffer<uint> coarse1Receivers;
[[vk::binding(26)]] RWStructuredBuffer<float> coarse0Features;
[[vk::binding(27)]] RWStructuredBuffer<float> coarse1Features;
// Vertex -> incident-triangle CSR, derived from clothTriangles once at load time by
// hoodLoadAssets. Appended after the pre-existing bindings so none of them move.
[[vk::binding(29)]] StructuredBuffer<uint> clothTriangleOffsets;
[[vk::binding(30)]] StructuredBuffer<uint> clothTriangleIndices;

float normalizeFeature(float value, uint meanOffset, uint stdOffset, uint index)
{
    return (value - normalizers[meanOffset + index]) / normalizers[stdOffset + index];
}

float3 effectiveClothPosition(uint vertex)
{
    return (pinMask[vertex] != 0 ? pinTarget[vertex] : clothPosition[vertex]).xyz;
}

float3 clothNormal(uint vertex)
{
    float3 sum = 0.0;
    // Walk only the triangles incident to this vertex. The CSR keeps them in ascending
    // triangle order and stores each one once, so the accumulation is bit-identical to the
    // old scan over every triangle in the mesh.
    const uint beginTriangle = clothTriangleOffsets[vertex];
    const uint endTriangle = clothTriangleOffsets[vertex + 1];
    [loop] for (uint slot = beginTriangle; slot < endTriangle; ++slot) {
        const uint triIndex = clothTriangleIndices[slot];
        const uint3 ids = uint3(clothTriangles[triIndex * 3], clothTriangles[triIndex * 3 + 1], clothTriangles[triIndex * 3 + 2]);
        const float3 a = effectiveClothPosition(ids.x);
        const float3 b = effectiveClothPosition(ids.y);
        const float3 c = effectiveClothPosition(ids.z);
        const float3 e0 = b - a, e1 = c - b, e2 = a - c;
        sum += cross(e0, e1) + cross(e1, e2) + cross(e2, e0);
    }
    const float lengthSquared = dot(sum, sum);
    return lengthSquared > 1.0e-20 ? sum * rsqrt(lengthSquared) : float3(0.0, 1.0, 0.0);
}

void writeNode(uint node, float3 velocity, uint type, uint level, float3 normal, float logMass, float3 material)
{
    float raw[21];
    raw[0] = velocity.x; raw[1] = velocity.y; raw[2] = velocity.z;
    [unroll] for (uint i = 0; i < 9; ++i) raw[3 + i] = weights[params.embeddingOffset + type * 9 + i];
    [unroll] for (uint j = 0; j < 4; ++j) raw[12 + j] = weights[params.levelEmbeddingOffset + level * 4 + j];
    raw[16] = normal.x; raw[17] = normal.y; raw[18] = normal.z;
    raw[19] = params.timestep; raw[20] = logMass;
    [unroll] for (uint k = 0; k < 21; ++k) nodeFeatures[node * 24 + k] = normalizeFeature(raw[k], 0, 21, k);
    nodeFeatures[node * 24 + 21] = material.x;
    nodeFeatures[node * 24 + 22] = material.y;
    nodeFeatures[node * 24 + 23] = material.z;
}

void writeClothEdge(uint edge, uint sender, uint receiver, RWStructuredBuffer<float> destination)
{
    const float3 relative = effectiveClothPosition(sender) - effectiveClothPosition(receiver);
    const float3 relativeRest = clothRestPosition[sender].xyz - clothRestPosition[receiver].xyz;
    const float raw[9] = { relative.x, relative.y, relative.z, length(relative),
        relativeRest.x, relativeRest.y, relativeRest.z, length(relativeRest), params.timestep };
    [unroll] for (uint i = 0; i < 9; ++i) destination[edge * 12 + i] = normalizeFeature(raw[i], 42, 51, i);
    destination[edge * 12 + 9] = params.material0;
    destination[edge * 12 + 10] = params.material1;
    destination[edge * 12 + 11] = params.material2;
}

[numthreads(128, 1, 1)]
void main(uint3 dispatchId : SV_DispatchThreadID)
{
    const uint index = dispatchId.x;
    if (index < params.clothCount) {
        const bool pinned = pinMask[index] != 0;
        const float3 current = effectiveClothPosition(index);
        const float3 previous = pinned ? clothPosition[index].xyz : clothPrevious[index].xyz;
        effectivePosition[index] = float4(current, 1.0);
        writeNode(index, current - previous, pinned ? 3 : 0, vertexLevel[index], clothNormal(index),
            log(max(clothMass[index], 1.0e-20)), float3(params.material0, params.material1, params.material2));

        // hood_world_nearest.comp already picked the nearest proxy and marked it active.
        const uint nearest = worldObstacle[index];
        if (nearest != 0xffffffffu) {
            const float3 relativeCurrent = current - proxyPosition[nearest].xyz;
            const float3 relativeTarget = current - proxyTarget[nearest].xyz;
            const float direct[9] = { relativeCurrent.x, relativeCurrent.y, relativeCurrent.z, length(relativeCurrent),
                relativeTarget.x, relativeTarget.y, relativeTarget.z, length(relativeTarget), params.timestep };
            [unroll] for (uint w = 0; w < 9; ++w) {
                worldDirectFeatures[index * 9 + w] = normalizeFeature(direct[w], 60, 69, w);
                const bool vectorComponent = (w < 3) || (w >= 4 && w < 7);
                worldInverseFeatures[index * 9 + w] = normalizeFeature(vectorComponent ? -direct[w] : direct[w], 60, 69, w);
            }
        }
    }
    if (index < params.proxyCount)
        writeNode(params.clothCount + index, proxyTarget[index].xyz - proxyPosition[index].xyz, 1, 0,
            normalize(proxyNormal[index].xyz), -1.0, -1.0.xxx);
    if (index < params.meshEdgeCount)
        writeClothEdge(index, meshSenders[index], meshReceivers[index], meshFeatures);
    if (index < params.coarse0Count)
        writeClothEdge(index, coarse0Senders[index], coarse0Receivers[index], coarse0Features);
    if (index < params.coarse1Count)
        writeClothEdge(index, coarse1Senders[index], coarse1Receivers[index], coarse1Features);
}
