#include "hood_mlp.hlsli"

struct Push { uint mlpId, kind, count, clothCount, activeLevel; };
[[vk::push_constant]] Push push;
[[vk::binding(0)]] StructuredBuffer<float> weights;
[[vk::binding(1)]] StructuredBuffer<uint4> mlpTable;
[[vk::binding(2)]] StructuredBuffer<float> nodeLatent;
[[vk::binding(3)]] StructuredBuffer<float> meshIn;
[[vk::binding(4)]] StructuredBuffer<float> coarse0In;
[[vk::binding(5)]] StructuredBuffer<float> coarse1In;
[[vk::binding(6)]] StructuredBuffer<float> worldDirectIn;
[[vk::binding(7)]] StructuredBuffer<float> worldInverseIn;
[[vk::binding(8)]] RWStructuredBuffer<float> meshOut;
[[vk::binding(9)]] RWStructuredBuffer<float> coarse0Out;
[[vk::binding(10)]] RWStructuredBuffer<float> coarse1Out;
[[vk::binding(11)]] RWStructuredBuffer<float> worldDirectOut;
[[vk::binding(12)]] RWStructuredBuffer<float> worldInverseOut;
[[vk::binding(13)]] StructuredBuffer<uint> meshSenders;
[[vk::binding(14)]] StructuredBuffer<uint> meshReceivers;
[[vk::binding(15)]] StructuredBuffer<uint> coarse0Senders;
[[vk::binding(16)]] StructuredBuffer<uint> coarse0Receivers;
[[vk::binding(17)]] StructuredBuffer<uint> coarse1Senders;
[[vk::binding(18)]] StructuredBuffer<uint> coarse1Receivers;
[[vk::binding(19)]] StructuredBuffer<uint> worldObstacle;
[[vk::binding(20)]] StructuredBuffer<uint> vertexLevel;

float oldEdge(uint element, uint lane)
{
    if (push.kind == 0) return meshIn[element * 128 + lane];
    if (push.kind == 1) return coarse0In[element * 128 + lane];
    if (push.kind == 2) return coarse1In[element * 128 + lane];
    if (push.kind == 3) return worldDirectIn[element * 128 + lane];
    return worldInverseIn[element * 128 + lane];
}

void writeEdge(uint element, uint lane, float value)
{
    if (push.kind == 0) meshOut[element * 128 + lane] = value;
    else if (push.kind == 1) coarse0Out[element * 128 + lane] = value;
    else if (push.kind == 2) coarse1Out[element * 128 + lane] = value;
    else if (push.kind == 3) worldDirectOut[element * 128 + lane] = value;
    else worldInverseOut[element * 128 + lane] = value;
}

float edgeValue(uint element, uint index)
{
    uint sender, receiver;
    if (push.kind == 0) { sender = meshSenders[element]; receiver = meshReceivers[element]; }
    else if (push.kind == 1) { sender = coarse0Senders[element]; receiver = coarse0Receivers[element]; }
    else if (push.kind == 2) { sender = coarse1Senders[element]; receiver = coarse1Receivers[element]; }
    else {
        const uint cloth = element;
        const uint obstacle = push.clothCount + worldObstacle[cloth];
        if (push.kind == 3) { sender = cloth; receiver = obstacle; }
        else { sender = obstacle; receiver = cloth; }
    }
    if (index < 128) return nodeLatent[receiver * 128 + index];
    if (index < 256) return nodeLatent[sender * 128 + index - 128];
    return oldEdge(element, index - 256);
}

groupshared float edgeInput[384];

[numthreads(128, 1, 1)]
void main(uint3 groupId : SV_GroupID, uint lane : SV_GroupIndex)
{
    const uint element = groupId.x;
    if (element >= push.count) return;
    const bool worldInactive = push.kind >= 3 &&
        (worldObstacle[element] == 0xffffffffu || vertexLevel[element] < push.activeLevel);
    if (push.mlpId == 0xffffffffu || worldInactive) {
        writeEdge(element, lane, oldEdge(element, lane));
        return;
    }
    edgeInput[lane] = edgeValue(element, lane);
    edgeInput[lane + 128] = edgeValue(element, lane + 128);
    edgeInput[lane + 256] = edgeValue(element, lane + 256);
    GroupMemoryBarrierWithGroupSync();
    const MlpDesc mlp = loadMlp(mlpTable, push.mlpId);
    float value = weights[mlp.b0 + lane];
    [loop] for (uint input = 0; input < 384; ++input)
        value += weights[mlp.w0 + input * 128 + lane] * edgeInput[input];
    hoodScratchA[lane] = max(value, 0.0);
    GroupMemoryBarrierWithGroupSync();
    hoodScratchB[lane] = max(hiddenLinear(weights, mlp.w1, mlp.b1, lane, 128, 128, true), 0.0);
    GroupMemoryBarrierWithGroupSync();
    hoodScratchA[lane] = hiddenLinear(weights, mlp.w2, mlp.b2, lane, 128, 128, false);
    calculateLayerNorm(lane, 128);
    const float update = (hoodScratchA[lane] - hoodMean) * hoodInvStd * weights[mlp.lnWeight + lane] + weights[mlp.lnBias + lane];
    writeEdge(element, lane, oldEdge(element, lane) + update);
}
