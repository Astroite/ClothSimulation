#include "hood_mlp.hlsli"

struct Push { uint block, kind, count, clothCount; };
[[vk::push_constant]] Push push;
[[vk::binding(0)]] StructuredBuffer<float> weights;
[[vk::binding(1)]] StructuredBuffer<uint4> mlpTable;
[[vk::binding(2)]] StructuredBuffer<float> nodeLatent;
[[vk::binding(3)]] StructuredBuffer<float> meshIn;
[[vk::binding(4)]] StructuredBuffer<float> worldDirectIn;
[[vk::binding(5)]] StructuredBuffer<float> worldInverseIn;
[[vk::binding(6)]] RWStructuredBuffer<float> meshOut;
[[vk::binding(7)]] RWStructuredBuffer<float> worldDirectOut;
[[vk::binding(8)]] RWStructuredBuffer<float> worldInverseOut;
[[vk::binding(9)]] StructuredBuffer<uint> meshSenders;
[[vk::binding(10)]] StructuredBuffer<uint> meshReceivers;
[[vk::binding(11)]] StructuredBuffer<uint> worldObstacle;

float edgeValue(uint element, uint index)
{
    if (push.kind == 0) {
        if (index < 128) return nodeLatent[meshReceivers[element] * 128 + index];
        if (index < 256) return nodeLatent[meshSenders[element] * 128 + index - 128];
        return meshIn[element * 128 + index - 256];
    }
    const uint cloth = element;
    const uint obstacleNode = push.clothCount + worldObstacle[cloth];
    if (push.kind == 1) {
        if (index < 128) return nodeLatent[obstacleNode * 128 + index];
        if (index < 256) return nodeLatent[cloth * 128 + index - 128];
        return worldDirectIn[cloth * 128 + index - 256];
    }
    if (index < 128) return nodeLatent[cloth * 128 + index];
    if (index < 256) return nodeLatent[obstacleNode * 128 + index - 128];
    return worldInverseIn[cloth * 128 + index - 256];
}
float oldEdge(uint element, uint lane)
{
    return push.kind == 0 ? meshIn[element * 128 + lane] : (push.kind == 1 ? worldDirectIn[element * 128 + lane] : worldInverseIn[element * 128 + lane]);
}
void writeEdge(uint element, uint lane, float value)
{
    if (push.kind == 0) meshOut[element * 128 + lane] = value;
    else if (push.kind == 1) worldDirectOut[element * 128 + lane] = value;
    else worldInverseOut[element * 128 + lane] = value;
}

// Every lane consumes all 384 inputs, so a per-lane global gather issues 128 x 384 loads to
// read 384 distinct floats. Stage the vector cooperatively instead -- three coalesced loads
// per lane -- and take the inner loop from groupshared, the way hood_node_update.comp
// already does with its aggregates.
groupshared float edgeInput[384];

[numthreads(128, 1, 1)]
void main(uint3 groupId : SV_GroupID, uint lane : SV_GroupIndex)
{
    const uint element = groupId.x;
    // Both terms are uniform across the workgroup, so the whole group exits together and the
    // barriers below stay well formed.
    if (element >= push.count || (push.kind != 0 && worldObstacle[element] == 0xffffffffu)) return;
    edgeInput[lane] = edgeValue(element, lane);
    edgeInput[lane + 128] = edgeValue(element, lane + 128);
    edgeInput[lane + 256] = edgeValue(element, lane + 256);
    GroupMemoryBarrierWithGroupSync();
    const MlpDesc mlp = loadMlp(mlpTable, 3 + push.block * 3 + (push.kind == 0 ? 0 : 1));
    float value = weights[mlp.b0 + lane];
    [loop] for (uint input = 0; input < 384; ++input) value += weights[mlp.w0 + input * 128 + lane] * edgeInput[input];
    hoodScratchA[lane] = max(value, 0.0);
    GroupMemoryBarrierWithGroupSync();
    hoodScratchB[lane] = max(hiddenLinear(weights, mlp.w1, mlp.b1, lane, 128, 128, true), 0.0);
    GroupMemoryBarrierWithGroupSync();
    hoodScratchA[lane] = hiddenLinear(weights, mlp.w2, mlp.b2, lane, 128, 128, false);
    calculateLayerNorm(lane, 128);
    const float update = (hoodScratchA[lane] - hoodMean) * hoodInvStd * weights[mlp.lnWeight + lane] + weights[mlp.lnBias + lane];
    writeEdge(element, lane, oldEdge(element, lane) + update);
}
