// Shader-friendly fixed-topology GNN, layer 0.
// One 32-lane workgroup owns one vertex. No atomics or wave-size assumptions.

#include "common.hlsli"


groupshared float neighborFeature[VGNN_INPUT_DIM];

float rawFeature(uint vertex, uint channel)
{
    Particle particle = particleIn[vertex];
    if (channel < 3) return particle.pos[channel] - particle.rest[channel];
    if (channel < 6) return particle.vel[channel - 3];
    if (channel < 9) return params.gravity[channel - 6];
    return particle.rest.w;
}

float scaledFeature(uint vertex, uint channel)
{
    return rawFeature(vertex, channel) * weights[VGNN_INPUT_SCALE_OFFSET + channel];
}

[numthreads(32, 1, 1)]
void main(uint3 groupID : SV_GroupID, uint lane : SV_GroupIndex)
{
    const uint vertex = groupID.x;
    if (vertex >= params.vertexCount) return;

    if (lane < VGNN_INPUT_DIM) {
        const uint begin = vertexOffsets[vertex];
        const uint end = vertexOffsets[vertex + 1];
        float sum = 0.0;
        for (uint edge = begin; edge < end; ++edge) {
            sum += scaledFeature(neighborIndices[edge], lane);
        }
        neighborFeature[lane] = sum / max(float(end - begin), 1.0);
    }
    GroupMemoryBarrierWithGroupSync();

    if (lane < VGNN_HIDDEN_DIM) {
        float value = weights[VGNN_BIAS0_OFFSET + lane];
        [unroll]
        for (uint inputChannel = 0; inputChannel < VGNN_INPUT_DIM; ++inputChannel) {
            const uint matrixIndex = lane * VGNN_INPUT_DIM + inputChannel;
            value += scaledFeature(vertex, inputChannel) * weights[VGNN_SELF0_OFFSET + matrixIndex];
            value += neighborFeature[inputChannel] * weights[VGNN_NEIGHBOR0_OFFSET + matrixIndex];
        }
        hiddenState[vertex * 4 + lane / 4][lane % 4] = max(value, 0.0);
    }
}
